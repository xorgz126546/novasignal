# =====================================================================
# CRYPTONEX AI — environment template. PLACEHOLDERS ONLY.
# Copy to backend/.env (local) or set as secrets in your host. Never commit real values.
# =====================================================================

# --- App ---
ENVIRONMENT=development            # development | production
SECRET_KEY=change-me-to-64-random-chars   # python -c "import secrets;print(secrets.token_urlsafe(48))"
ACCESS_TOKEN_MINUTES=720
CORS_ORIGINS=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5173   # dashboard URL used in Telegram links

# --- Database (single source of truth) ---
# Local dev default is SQLite. Production: PostgreSQL.
DATABASE_URL=sqlite:///./cryptonex.db
# DATABASE_URL=postgresql+psycopg://cryptonex:<password>@<host>:5432/cryptonex

# --- Binance: PUBLIC market data only. No API key. No trading. No withdrawals. ---
BINANCE_BASE_URL=https://data-api.binance.vision
BINANCE_MAX_WEIGHT_PER_MINUTE=1000

# --- Telegram (create a bot with @BotFather) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=           # random 32+ chars; Telegram echoes it in X-Telegram-Bot-Api-Secret-Token

# --- Optional providers ---
CRYPTOPANIC_API_KEY=               # news for Agent 07; empty => agent reports NO_DATA (never invents news)
ANTHROPIC_API_KEY=                 # optional plain-English narrative for approved signals
ANTHROPIC_MODEL=claude-opus-5-5

# --- Scheduler: enable on exactly ONE backend instance ---
ENABLE_SCHEDULER=false
SCAN_INTERVAL_MINUTES=15
TRACKER_INTERVAL_SECONDS=60
DAILY_SUMMARY_HOUR_UTC=21

# --- Billing: keep false until payments, legal review and reliability are verified ---
BILLING_ENABLED=false

# --- Optional first admin (otherwise the first registered account becomes admin) ---
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- CRYPTONEX HQ (15-agent company) ---
HQ_ENABLED=false                    # true = run the HQ schedule (cycles, auditor, 08:00 brief, weekly Library…)
TELEGRAM_CHAT_ID=                   # your own chat id (briefs, reports, critical alerts)
GITHUB_TOKEN=                       # fine-grained, ONLY this repo: Contents + Pull requests (read/write). Never classic tokens.
GITHUB_REPO=xorgz126546/novasignal
HQ_LLM_DAILY_BUDGET_USD=1.0         # hard daily cap; when reached agents fall back to deterministic templates
HQ_MODEL_ROUTINE=claude-haiku-5-5   # cheap model for routine agents
HQ_MODEL_SENIOR=claude-opus-5-5     # Manager + Engineer
HQ_TIMEZONE=Africa/Algiers
HQ_BRIEF_HOUR=8
HQ_LIBRARY_WEEKDAY=4                # 0=Mon … 4=Fri
HQ_SCAN_INTERVAL_MINUTES=30
HQ_DAILY_PICK=true                  # daily best recommendation + weekly tournament (runs even if HQ_ENABLED=false)
HQ_DAILY_PICK_TIME=09:00,13:00,17:00,21:00   # re-checks until the day's pick is found

# --- Frontend (Vite) ---
# VITE_API_URL=https://api.your-domain.com   # leave empty when the API is served on the same origin under /api
